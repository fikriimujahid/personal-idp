# =============================================================================
# Fikri IDP Local Development Environment
# =============================================================================
# Copy this file to .env and adjust values as needed.
# The .env file is git-ignored and contains local development secrets.

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=fikri_idp
POSTGRES_PASSWORD=fikri_idp
POSTGRES_DB=fikri_idp

# ── Authentication ──────────────────────────────────────────────────────────
# AUTH_MODE: local (dev) or cognito (production)
AUTH_MODE=local
AUTH_LOCAL_SECRET=fikri-idp-dev-jwt-secret-do-not-use-in-production
AUTH_LOCAL_ISSUER=fikri-idp-local

# ── AWS / LocalStack ────────────────────────────────────────────────────────
# These credentials are for LocalStack only. Never use in production.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_ENDPOINT=http://localstack:4566
LOCALSTACK_DEBUG=0

# ── SQS ─────────────────────────────────────────────────────────────────────
SQS_QUEUE_PREFIX=http://localstack:4566/000000000000/

# ── S3 ──────────────────────────────────────────────────────────────────────
TERRAFORM_STATE_BUCKET=fikri-idp-tfstate

# ── Secrets Manager ─────────────────────────────────────────────────────────
SECRETS_PREFIX=fikri-idp/dev/

# ── Portal ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
